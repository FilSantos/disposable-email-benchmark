# ---------------------------------------------------------------------------
# Email Provider Benchmark Framework — environment template
# Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Transport -----------------------------------------------------------------
# loopback | direct-mx | relay
# loopback  : local SMTP accepts the message only (no external delivery). Safe default.
# direct-mx : connect to the provider MX on port 25 (blocked in many networks).
# relay     : send via an authenticated SMTP relay (requires EBB_RELAY_* below).
EBM_TRANSPORT=loopback

# Local SMTP server bind (loopback only by default)
EBM_SMTP_HOST=127.0.0.1
EBM_SMTP_PORT=2525
EBM_SMTP_TIMEOUT_MS=15000

# --- Relay transport (only used when EBM_TRANSPORT=relay) ----------------------
EBM_RELAY_HOST=
EBM_RELAY_PORT=587
EBM_RELAY_SECURE=false
EBM_RELAY_USER=
EBM_RELAY_PASS=

# --- Sender identity -----------------------------------------------------------
# MUST be a sender the relay is authorised to use. A non-authorised sender may be
# accepted (250 queued) but never delivered — which looks like a provider failure
# and is not one.
EBM_SEND_FROM=filipe@foodsistema.com.br

# --- Provider API credentials (optional; capability-gated) ---------------------
# Mailinator requires an API token (free Verified Pro or a paid tier).
EBM_MAILINATOR_TOKEN=
# Maildrop GraphQL requires no authentication — nothing to set.
# Guerrilla Mail requires no API key — nothing to set.

# --- Benchmark defaults --------------------------------------------------------
EBM_POLL_INTERVAL_MS=2000
EBM_DETECTION_TIMEOUT_MS=180000
EBM_TRANSPORT_TIMEOUT_MS=15000
EBM_SAMPLES_PER_PROVIDER=3
EBM_RUNS=1
